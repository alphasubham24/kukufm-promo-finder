# Copy this file to .env and fill in your values.
# Never commit .env — it is listed in .gitignore.

# ── LLM provider (any OpenAI-compatible Chat Completions API) ────────────────
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=openai/gpt-oss-120b

# ── Optional tuning ──────────────────────────────────────────────────────────
# LLM_TPM=8000          # client-side token/min throttle (use for Groq free tier)
# LLM_CONCURRENCY=4     # parallel LLM calls (reduce to 1 on tight free tiers)
# LLM_EXTRA_JSON={}     # extra request fields, e.g. {"reasoning_effort":"low"}
# EPISODES_PER_CALL=3   # episodes batched per LLM call

# ── Provider examples ────────────────────────────────────────────────────────
# Groq (free tier):
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=openai/gpt-oss-120b
#   LLM_TPM=8000
#   LLM_CONCURRENCY=1
#
# AWS Bedrock:
#   LLM_BASE_URL=https://bedrock-runtime.<region>.amazonaws.com/openai/v1
#   LLM_MODEL=openai.gpt-oss-120b-1:0
#
# Google Gemini:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=gemini-2.0-flash

